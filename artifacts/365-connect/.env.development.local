# Dev-only quick-login helpers.
# This file is loaded by Vite in development mode only and should NEVER be committed.
# Add *.local to .gitignore to keep it out of version control.

VITE_APP_ENV=development

# Test account emails (non-sensitive)
VITE_TEST_WORKER_EMAIL=worker.test.qa1@example.com
VITE_TEST_CLIENT_EMAIL=client.test.qa1@example.com
VITE_TEST_ADMIN_EMAIL=admin@365connect.com
